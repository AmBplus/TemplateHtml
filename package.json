{
  "name": "tempalteui",
  "version": "1.0.0",
  "description": "RTL Persian Student Portal UI",
  "main": "index.js",
  "scripts": {
    "dev": "npm run watch:css",
    "build": "npm run build:css",
    "build:css": "sass --style=compressed ./wwwroot/scss/admin.scss ./wwwroot/css/output-compiled.css --no-source-map && npx tailwindcss -i ./wwwroot/css/input.css -o ./wwwroot/css/output.css --minify && node -e \"const fs=require('fs');fs.appendFileSync('wwwroot/css/output.css', fs.readFileSync('wwwroot/css/output-compiled.css'));fs.unlinkSync('wwwroot/css/output-compiled.css');\"",
    "watch:css": "npx tailwindcss -i ./wwwroot/css/input.css -o ./wwwroot/css/output.css --watch",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "rtl",
    "persian",
    "tailwind",
    "student-portal"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.10",
    "postcss-scss": "^4.0.4",
    "sass": "^1.99.0",
    "tailwindcss": "^3.4.19"
  }
}